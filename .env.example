# Copy this file to `.env` (which is git-ignored) and fill in YOUR local
# paths. Anyone on the team does this once on their own machine — nobody's
# personal folder structure needs to touch the actual code or the repo.
#
# Not needed at all on Linux/macOS if Tesseract and Poppler were installed
# via a package manager (apt/brew) — they're already on PATH there, so you
# can leave both blank or skip this file entirely.

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\path\to\poppler-xx.xx.x\Library\bin
